{
    "layer": "top",
    "position": "top",
    "height": 54,
    "spacing": 0,
    "exclusive": true,

    "modules-left":   ["group/hw", "group/ws"],
    "modules-center": [],
    "modules-right":  ["group/info", "group/systray"],

    // ─── GROUPS ──────────────────────────────────────────────────────────────

    "group/hw": {
        "orientation": "horizontal",
        "modules": ["cpu", "temperature#cpu", "custom/gpu-util", "custom/gpu-temp", "memory"]
    },

    "group/ws": {
        "orientation": "horizontal",
        "modules": ["hyprland/workspaces", "hyprland/window"]
    },

    "group/info": {
        "orientation": "horizontal",
        "modules": ["network", "pulseaudio", "hyprland/language", "custom/updates"]
    },

    "group/systray": {
        "orientation": "horizontal",
        "modules": ["tray"]
    },

    // ─── HARDWARE ────────────────────────────────────────────────────────────

    "cpu": {
        "format": "󰻠 {usage}%",
        "tooltip-format": "CPU: {usage}%\n{avg_frequency} GHz",
        "interval": 2
    },

    "temperature#cpu": {
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 85,
        "format": "{temperatureC}°",
        "format-critical": "{temperatureC}°",
        "tooltip-format": "CPU Temp: {temperatureC}°C",
        "interval": 2
    },

    "custom/gpu-util": {
        "exec": "~/.config/waybar/scripts/gpu-util.sh",
        "interval": 3,
        "tooltip": false
    },

    "custom/gpu-temp": {
        "exec": "~/.config/waybar/scripts/gpu-temp.sh",
        "interval": 3,
        "tooltip": false
    },

    "memory": {
        "format": "󰾆 {percentage}%",
        "tooltip-format": "RAM: {used:.1f} / {total:.1f} GiB\nSwap: {swapUsed:.1f} / {swapTotal:.1f} GiB",
        "interval": 5
    },

    // ─── WORKSPACES ──────────────────────────────────────────────────────────

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "all-outputs": false,
        "show-special": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 36,
        "separate-outputs": true,
        "rewrite": {
            "^(.*) — Mozilla Firefox$":   "  $1",
            "^(.*) - Mozilla Firefox$":   "  $1",
            "^Mozilla Firefox$":           "  Firefox",
            "^(.*) — Chromium$":           "  $1",
            "^(.*) - Visual Studio Code$": "󰨞  $1",
            "^(.*) — Dolphin$":            "  $1",
            "^Telegram.*$":                "  Telegram",
            "^(.*) - kitty$":              "  $1",
            "^(.*) — kitty$":              "  $1",
            "^nvim(.*)$":                  "  nvim$1",
            "^(.*)nvim(.*)$":              "  $1nvim$2"
        }
    },

    // ─── STATUS ──────────────────────────────────────────────────────────────

    "network": {
        "interval": 2,
        "format-wifi":        "󰤨 {essid}",
        "format-ethernet":    "󱘖 {ifname}",
        "format-linked":      "󱘖 {ifname}",
        "format-disconnected": "󰤭 Offline",
        "tooltip-format-wifi":
            "󰤨  {essid}   {signalStrength}%\n󰆇  {ipaddr}/{cidr}\n󰇚  {bandwidthDownBytes}/s\n󰕒  {bandwidthUpBytes}/s\n   {frequency} GHz",
        "tooltip-format-ethernet":
            "󰈀  {ifname}\n󰆇  {ipaddr}/{cidr}\n󰇚  {bandwidthDownBytes}/s\n󰕒  {bandwidthUpBytes}/s",
        "tooltip-format-disconnected": "󰤭  No connection"
    },

    "pulseaudio": {
        "format":       "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": {
            "headphones": "󰋋",
            "headset":    "󰋎",
            "default":    ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "󰓃  {desc}\n   {volume}%",
        "on-click":     "/home/h0nova/.config/hypr/scripts/open-on-current-workspace.sh pavucontrol",
        "scroll-step":  5
    },

    "hyprland/language": {
        "format":    "󰌌 {short}",
        "format-us": "󰌌 EN",
        "format-ua": "󰌌 UA",
        "on-click":  "hyprctl switchxkblayout all next"
    },

    "custom/updates": {
        "exec":        "~/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "format":      "󰮯 {text}",
        "interval":    60,
        "signal":      8,
        "on-click":    "~/.config/waybar/scripts/update-run.sh"
    },

    // ─── TRAY ────────────────────────────────────────────────────────────────

    "tray": {
        "icon-size": 16,
        "spacing": 10,
        "show-passive-items": true
    }
}
